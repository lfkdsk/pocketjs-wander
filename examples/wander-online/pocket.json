{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.lfkdsk.pocket-rpgkit-wander-online",
  "name": "pocket-rpgkit-wander-online",
  "title": "Pocket RPG Kit — Wander Online",
  "version": "0.2.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "net.socket"
      ],
      "enhances": [
        "display.viewport.live"
      ]
    }
  },
  "app": {
    "entry": "examples/wander-online/wander-online.tsx",
    "output": "wander-online",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
